<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.Controller">
   <children>
      <VBox prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <TableView fx:id="tabelMahasiswa" prefHeight="400.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="nimCol" prefWidth="100.0" text="NIM" />
                <TableColumn fx:id="namaCol" prefWidth="150.0" text="Nama" />
                <TableColumn fx:id="hobiCol" prefWidth="150.0" text="Hobi" />
                <TableColumn fx:id="makananCol" prefWidth="150.0" text="Makanan Favorit" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>