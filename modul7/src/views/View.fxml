<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="750.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
  <tabs>
    <Tab text="Data Pelanggan">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <Label layoutX="20.0" layoutY="20.0" text="KELOLA PELANGGAN">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
                  <Label layoutX="20.0" layoutY="60.0" text="Nama" />
                  <TextField fx:id="txtNama" layoutX="90.0" layoutY="56.0" prefWidth="200.0" promptText="Nama Lengkap" />
                  <Label layoutX="20.0" layoutY="100.0" text="Email" />
                  <TextField fx:id="txtEmail" layoutX="90.0" layoutY="96.0" prefWidth="200.0" promptText="email@contoh.com" />
                  <Label layoutX="20.0" layoutY="140.0" text="Telepon" />
                  <TextField fx:id="txtTelepon" layoutX="90.0" layoutY="136.0" prefWidth="200.0" promptText="08..." />
                  
                  <Button layoutX="90.0" layoutY="180.0" onAction="#onAddPelanggan" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add" />
                  <Button layoutX="150.0" layoutY="180.0" onAction="#onEditPelanggan" style="-fx-background-color: #FFC107;" text="Edit" />
                  <Button layoutX="210.0" layoutY="180.0" onAction="#onDeletePelanggan" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete" />
                  
                  <TableView fx:id="tblPelanggan" layoutX="320.0" layoutY="56.0" prefHeight="400.0" prefWidth="400.0">
                    <columns>
                      <TableColumn fx:id="colNama" prefWidth="120.0" text="Nama" />
                      <TableColumn fx:id="colEmail" prefWidth="140.0" text="Email" />
                      <TableColumn fx:id="colTelepon" prefWidth="120.0" text="Telepon" />
                    </columns>
                  </TableView>
               </children>
        </AnchorPane>
      </content>
    </Tab>

    <Tab text="Data Buku">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <Label layoutX="20.0" layoutY="20.0" text="KELOLA BUKU">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
                  <Label layoutX="20.0" layoutY="60.0" text="Judul" />
                  <TextField fx:id="txtJudul" layoutX="90.0" layoutY="56.0" prefWidth="200.0" />
                  <Label layoutX="20.0" layoutY="100.0" text="Penulis" />
                  <TextField fx:id="txtPenulis" layoutX="90.0" layoutY="96.0" prefWidth="200.0" />
                  <Label layoutX="20.0" layoutY="140.0" text="Harga" />
                  <TextField fx:id="txtHarga" layoutX="90.0" layoutY="136.0" prefWidth="200.0" promptText="Rp." />
                  <Label layoutX="20.0" layoutY="180.0" text="Stok" />
                  <TextField fx:id="txtStok" layoutX="90.0" layoutY="176.0" prefWidth="200.0" />
                  
                  <Button layoutX="90.0" layoutY="220.0" onAction="#onAddBuku" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add" />
                  <Button layoutX="150.0" layoutY="220.0" onAction="#onEditBuku" style="-fx-background-color: #FFC107;" text="Edit" />
                  <Button layoutX="210.0" layoutY="220.0" onAction="#onDeleteBuku" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete" />
                  
                  <TableView fx:id="tblBuku" layoutX="320.0" layoutY="56.0" prefHeight="400.0" prefWidth="400.0">
                    <columns>
                      <TableColumn fx:id="colJudul" prefWidth="130.0" text="Judul" />
                      <TableColumn fx:id="colPenulis" prefWidth="100.0" text="Penulis" />
                      <TableColumn fx:id="colHarga" prefWidth="100.0" text="Harga" />
                      <TableColumn fx:id="colStok" prefWidth="50.0" text="Stok" />
                    </columns>
                  </TableView>
               </children>
        </AnchorPane>
      </content>
    </Tab>

    <Tab text="Data Penjualan">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <Label layoutX="20.0" layoutY="20.0" text="TRANSAKSI PENJUALAN">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
                  <Label layoutX="20.0" layoutY="60.0" text="Pelanggan" />
                  <ComboBox fx:id="comboPelanggan" layoutX="100.0" layoutY="56.0" prefWidth="200.0" promptText="Pilih Pelanggan" />
                  
                  <Label layoutX="20.0" layoutY="100.0" text="Buku" />
                  <ComboBox fx:id="comboBuku" layoutX="100.0" layoutY="96.0" prefWidth="200.0" promptText="Pilih Buku" />
                  
                  <Label layoutX="20.0" layoutY="140.0" text="Jumlah" />
                  <TextField fx:id="txtJumlah" layoutX="100.0" layoutY="136.0" prefWidth="200.0" promptText="Qty" />
                  
                  <Button layoutX="100.0" layoutY="180.0" onAction="#onAddPenjualan" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Bayar / Add" />
                  <Button layoutX="190.0" layoutY="180.0" onAction="#onDeletePenjualan" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Hapus" />
                  
                  <TableView fx:id="tblPenjualan" layoutX="320.0" layoutY="56.0" prefHeight="400.0" prefWidth="400.0">
                    <columns>
                      <TableColumn fx:id="colTanggal" prefWidth="90.0" text="Tanggal" />
                      <TableColumn fx:id="colJumlah" prefWidth="60.0" text="Jml" />
                      <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total (Rp)" />
                      <TableColumn fx:id="colPelangganId" prefWidth="60.0" text="ID Pel" />
                      <TableColumn fx:id="colBukuId" prefWidth="60.0" text="ID Buk" />
                    </columns>
                  </TableView>
               </children>
        </AnchorPane>
      </content>
    </Tab>
  </tabs>
</TabPane>